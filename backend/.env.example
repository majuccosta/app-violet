# Copie para backend/.env e preencha. NUNCA suba o .env para o GitHub.
DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
# Demonstração: aprova a verificação de identidade com qualquer foto válida (desligue em produção real)
VERIFICACAO_DEMO=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=violet
DB_USER=violet
DB_PASSWORD=sua-senha
DB_HOST=localhost
DB_PORT=5432
# Na nuvem (Supabase) use: DB_SSLMODE=require
DB_SSLMODE=prefer

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Em produção: https://SEU-USUARIO.github.io (sem barra no final e sem o nome do repositório)

# Fase de integrações
DIDIT_API_KEY=
